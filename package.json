    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261108.1",
    "@types/node": "26.6.6",
    "playwright-core": "1.62.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "wrangler": "4.158.0"
  }
}
