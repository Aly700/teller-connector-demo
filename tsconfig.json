{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node", "@cloudflare/workers-types"]
  },
  "include": ["ops/**/*.ts", "eval/**/*.ts", "apps/**/*.ts", "packages/**/*.ts", "origin/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts"]
}
